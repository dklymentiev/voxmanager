<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoxManager" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/green</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <!-- Android 15 (targetSdk 35) forces edge-to-edge, which drew our content
             under the status/nav bars (bottom control clipped). Opt out so the system
             bars keep their own space, matching how these screens were laid out. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- Reusable button components — adjust here once, applies everywhere -->
    <style name="AppButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
    <style name="AppButton.Primary">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AppButton.Neutral">
        <item name="android:background">@drawable/bg_btn_neutral</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="AppButton.Accent">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">#C9BDFF</item>
    </style>
    <style name="AppButton.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">#FF8A99</item>
    </style>

    <!-- Section label above each settings card -->
    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/faint</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginBottom">7dp</item>
    </style>

    <!-- One digit cell in the 6-box pairing code input -->
    <style name="CodeBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_code_box</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Tall, elongated digit cell for the full-screen pairing flow -->
    <style name="CodeBoxTall">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_code_box</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
    </style>
</resources>
