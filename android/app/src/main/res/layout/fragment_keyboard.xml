<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Connection: glowing dot + server name (top-left) -->
    <LinearLayout
        android:id="@+id/connRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/connDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_gray" />

        <TextView
            android:id="@+id/connText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/status_disconnected"
            android:textColor="@color/faint"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Settings gear (top-right) -->
    <ImageView
        android:id="@+id/gearButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:padding="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_gear"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Recognized text (hero, centered, scrolls as it grows) -->
    <ScrollView
        android:id="@+id/recognizedScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="18dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="96dp"
        app:layout_constraintTop_toBottomOf="@id/connRow"
        app:layout_constraintBottom_toTopOf="@id/waveHub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/recognizedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/ink"
            android:textSize="22sp"
            tools:text="сделай отчёт к пятнице" />
    </ScrollView>

    <!-- Reconnecting overlay: spinner + status (centered) -->
    <LinearLayout
        android:id="@+id/reconnectView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/waveHub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/reconnectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/status_reconnecting"
            android:textColor="#C9C9DC"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/reconnectSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/faint"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Error toast (e.g. connection lost) -->
    <TextView
        android:id="@+id/errorToast"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_toast_err"
        android:paddingVertical="12dp"
        android:paddingHorizontal="14dp"
        android:textColor="#FFD2D9"
        android:textSize="12.7sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/waveHub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Wave-button: indicator AND start/stop control in one -->
    <FrameLayout
        android:id="@+id/waveHub"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_hub_idle"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_wave_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.voxmanager.ui.WaveformView
            android:id="@+id/waveform"
            android:layout_width="232dp"
            android:layout_height="60dp"
            android:layout_gravity="center" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
