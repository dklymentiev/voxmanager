<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="23sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="22dp" />

        <!-- Computers (Wi-Fi style: connected on top, tap to connect/disconnect) -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/computers" />

        <LinearLayout
            android:id="@+id/pcContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyPcs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_pcs"
            android:textColor="@color/faint"
            android:textSize="14sp"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp"
            android:layout_marginBottom="9dp"
            android:visibility="gone" />

        <!-- + Pair new computer -->
        <LinearLayout
            android:id="@+id/addPcRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp"
            android:paddingVertical="14dp"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_plus"
                android:contentDescription="@string/pair_new_computer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_new_computer"
                android:textColor="#C9BDFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Recognition language -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/recognition_language" />

        <LinearLayout
            android:id="@+id/languageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="13dp"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/languageValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/faint"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Desktop app (where to get the PC server) -->
        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_desktop_app" />

        <LinearLayout
            android:id="@+id/desktopAppRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="13dp"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_desktop_app_sub"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/faint"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
