<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginBottom="9dp"
    android:paddingVertical="13dp"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/pcIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="13dp"
        android:src="@drawable/ic_monitor"
        android:contentDescription="@string/computers" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pcName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pcStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/faint"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pcDisconnect"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="7dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/disconnect"
        android:visibility="gone" />

</LinearLayout>
